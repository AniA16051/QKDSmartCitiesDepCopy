FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir --retries 10 --timeout 120 -r requirements.txt

# Copy entire project
COPY . .

# Set Python path
ENV PYTHONPATH=/app

# Create shared keystore directory
RUN mkdir -p /app/network/shared_keystore_data

# Default: this will be overridden by docker-compose run or docker run
# Example: docker-compose run user-node python -m network.sensor_node --id traffic-1 --type traffic_flow
CMD ["python", "-m", "network.sensor_node", "--id", "user-node-default", "--type", "traffic_flow"]
